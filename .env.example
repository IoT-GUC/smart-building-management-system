# The Things Network (TTN) Configuration
TTN_BASE_URL=https://eu1.cloud.thethings.network
TTN_APP_ID=your-ttn-app-id
TTN_API_KEY=your-ttn-api-key

# ThingsBoard Integration (optional)
THINGSBOARD_URL=http://localhost:8080
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=your-thingsboard-password

# SMTP Email Alerts
ALERT_EMAIL_SENDER=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password

# Admin Credentials
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session Secret
SESSION_SECRET=generate-a-random-string-here

# Local Test Mode (set to false in production)
LOCAL_TEST_MODE=false
